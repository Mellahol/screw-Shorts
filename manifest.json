{
  "manifest_version": 3,
  "name": "Shorts → Watch Link Rewriter",
  "version": "1.0.0",
  "description": "Rewrites youtube.com/shorts/ links to youtube.com/watch?v= links wherever they appear on the page.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shorts-rewriter@example.com",
      "strict_min_version": "109.0"
    }
  }
}
